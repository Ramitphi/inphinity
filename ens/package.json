{
  "name": "inphinity-ens",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ENSv2 fund registry for Inphinity: <label>.inphinity.eth on Sepolia",
  "scripts": {
    "register-parent": "bun run src/register-parent.ts",
    "setup-registry": "bun run src/setup-registry.ts",
