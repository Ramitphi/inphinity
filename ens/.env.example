# Copy to ens/.env (git-ignored) and fill in. Never commit the real file. bun loads it automatically.
#
# Key used by the ENS scripts (relayer.ts, fallback.ts, setup scripts). 64 hex chars, 0x optional.
# For the CCIP fallback loop (fallback-loop.sh) use a DEDICATED key, not the team wallet: grant it
# only the roles it needs with `bun run src/grant-fallback-roles.ts <address>` (run as the team
# wallet) and fund it with ~0.05 Sepolia ETH (one naming is ~4-7.5M gas).
PRIVATE_KEY=

# Optional RPC overrides
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# ARC_RPC_URL=https://rpc.testnet.arc.network
