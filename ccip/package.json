{
  "name": "inphinity-ccip",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Chainlink CCIP: Arc Testnet IndexFactory funds -> <label>.inphinity.eth on Sepolia ENSv2",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "deploy-sender": "bun run scripts/deploy-sender.ts",
    "deploy-receiver": "bun run scripts/deploy-receiver.ts",
    "grant-roles": "bun run scripts/grant-roles.ts",
    "announce": "bun run scripts/announce.ts",
    "status": "bun run scripts/status.ts",
    "typecheck": "tsc --noEmit",
    "fork:sepolia": "FORK_URL=${FORK_URL:-https://ethereum-sepolia-rpc.publicnode.com} FORK_CHAIN_ID=11155111 bunx hardhat --config test/hardhat.config.cjs node --port 8545",
    "fork:arc": "FORK_URL=${FORK_URL:-https://rpc.testnet.arc.network} FORK_CHAIN_ID=5042002 bunx hardhat --config test/hardhat.config.cjs node --port 8546",
    "test:fork": "bun run test/fork-e2e.ts"
  },
  "dependencies": {
    "@chainlink/contracts-ccip": "2.0.0",
    "viem": "2.57.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "bun-types": "1.3.1",
    "hardhat": "2.26.3",
    "solc": "0.8.28",
    "typescript": "5.9.3"
  }
}
