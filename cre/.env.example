# Copy to cre/.env (git-ignored) and fill in. Never commit the real file.
#
# Private key of a funded Arc Testnet wallet (gas is paid in USDC). Only needed for
# `cre workflow simulate ... --broadcast` and `cre workflow deploy`. A dry-run simulation
# does not send transactions. Any address works: the StockExchange only checks that the
# report came through the configured forwarder, not who paid the gas.
CRE_ETH_PRIVATE_KEY=

# Optional: API key for non-interactive CLI auth instead of `cre login` (CI, tmux loops).
# CRE_API_KEY=
